# Example Streamlit Secrets Configuration for DataDoctor
# Copy this file to .streamlit/secrets.toml for local development.
# In Streamlit Community Cloud, enter these under App Settings -> Secrets.
#
# NOTE: Never commit your actual secrets.toml to Git! (.streamlit/secrets.toml is in .gitignore)

GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-flash-lite-latest"

